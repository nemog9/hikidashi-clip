{
  "manifest_version": 3,
  "name": "Hikidashi クリップ",
  "version": "1.7.1",
  "description": "表示中のページを QR コードにして、iPhone の Hikidashi に保存します。",
  "action": {
    "default_title": "Hikidashi に保存（QR）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
